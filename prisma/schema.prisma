// ======================================================
// DATABASE
// ======================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  USER
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
  KYC_ADMIN
  MODERATOR
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TaskStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  DELETED
}

enum AdRewardStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TaskSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskType {
  APP_RATING
  APP_INSTALL
  LEAD_GENERATION
  CREDIT_CARD
  SURVEY
  CUSTOM
}

enum Currency {
  INR
}

enum KycStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum WalletStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum WalletTransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum WalletTransactionType {
  TRANSFER
  REWARD
  WITHDRAW
  RECHARGE
  TASK_REWARD
  AD_REWARD
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  SUCCESS
  FAILED
}

enum AppSource {
  FLUTTER_APP
  ANDROID
  IOS
  WEB
}

// ======================================================
// USER
// ======================================================

model User {
  id String @id @default(uuid())

  phone String @unique

  email String? @unique

  passwordHash String?

  source AppSource

  country String

  appId String?

  role UserRole @default(USER)

  isActive Boolean @default(true)

  isBlocked Boolean @default(false)

  deletedAt DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  profile Profile?

  wallet Wallet?

  kyc Kyc?

  sessions Session[]

  taskSubmissions TaskSubmission[]

  adRewardClaims AdRewardClaim[]

  @@index([phone])

  @@index([email])

  @@index([createdAt])
}

// ======================================================
// ADMIN USER
// ======================================================

model AdminUser {
  id String @id @default(uuid())

  email String @unique

  passwordHash String

  fullName String

  role AdminRole @default(OPERATIONS_ADMIN)

  isActive Boolean @default(true)

  isBlocked Boolean @default(false)

  lastLoginAt DateTime?

  createdBy String?

  updatedBy String?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  sessions AdminSession[]

  permissions AdminRolePermission[]

  auditLogs AdminAuditLog[]

  @@index([email])

  @@index([role])
}

// ======================================================
// ADMIN SESSION
// ======================================================

model AdminSession {
  id String @id @default(uuid())

  adminUserId String

  refreshTokenHash String

  ipAddress String?

  userAgent String?

  deviceName String?

  lastUsedAt DateTime?

  isRevoked Boolean @default(false)

  expiresAt DateTime

  createdAt DateTime @default(now())

  // RELATIONS
  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])

  @@map("admin_sessions")
}

// ======================================================
// ADMIN PERMISSIONS
// ======================================================

model AdminPermission {
  id String @id @default(uuid())

  key String @unique

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  roles AdminRolePermission[]

  @@index([key])
}

model AdminRolePermission {
  id String @id @default(uuid())

  adminUserId String

  permissionId String

  createdAt DateTime @default(now())

  // RELATIONS
  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, permissionId])

  @@index([adminUserId])

  @@index([permissionId])
}

// ======================================================
// ADMIN AUDIT LOG
// ======================================================

model AdminAuditLog {
  id String @id @default(uuid())

  adminUserId String

  action String

  entity String

  entityId String?

  metadata Json?

  ipAddress String?

  createdAt DateTime @default(now())

  // RELATIONS
  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])

  @@index([entity])

  @@index([createdAt])
}

// ======================================================
// USER SESSION
// ======================================================

model Session {
  id String @id @default(uuid())

  userId String

  refreshTokenHash String

  ipAddress String?

  userAgent String?

  deviceName String?

  fingerprint String?

  status SessionStatus @default(ACTIVE)

  expiresAt DateTime

  lastUsedAt DateTime?

  revokedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@index([status])

  @@index([expiresAt])
}

// ======================================================
// PROFILE
// ======================================================

model Profile {
  id String @id @default(uuid())

  userId String @unique

  username String? @unique

  firstName String?

  lastName String?

  bio String?

  dateOfBirth DateTime?

  language String?

  gender String?

  timezone String?

  email String?

  phone String?

  photoUrl String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@index([username])
}

// ======================================================
// WALLET
// ======================================================

model Wallet {
  id String @id @default(uuid())

  userId String @unique

  walletNumber String @unique

  walletHandle String @unique

  availableBalance Decimal @db.Decimal(18, 2)

  lockedBalance Decimal @db.Decimal(18, 2)

  currency Currency @default(INR)

  status WalletStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentTransactions WalletTransaction[] @relation("SenderWallet")

  receivedTransactions WalletTransaction[] @relation("ReceiverWallet")

  ledgerEntries LedgerEntry[]

  withdrawals Withdrawal[]

  @@index([userId])

  @@index([walletHandle])

  @@index([walletNumber])
}

// ======================================================
// WALLET TRANSACTION
// ======================================================

model WalletTransaction {
  id String @id @default(uuid())

  referenceId String @unique

  idempotencyKey String? @unique

  senderWalletId String?

  receiverWalletId String?

  amount Decimal @db.Decimal(18, 2)

  type WalletTransactionType

  status WalletTransactionStatus @default(PENDING)

  note String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  senderWallet Wallet? @relation("SenderWallet", fields: [senderWalletId], references: [id])

  receiverWallet Wallet? @relation("ReceiverWallet", fields: [receiverWalletId], references: [id])

  ledgerEntries LedgerEntry[]

  @@index([senderWalletId])

  @@index([receiverWalletId])

  @@index([referenceId])

  @@index([status])
}

// ======================================================
// LEDGER ENTRY
// ======================================================

model LedgerEntry {
  id String @id @default(uuid())

  walletId String

  transactionId String

  type LedgerEntryType

  amount Decimal @db.Decimal(18, 2)

  balanceAfter Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  // RELATIONS
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  transaction WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([walletId])

  @@index([transactionId])
}

// ======================================================
// WITHDRAWAL
// ======================================================

model Withdrawal {
  id String @id @default(uuid())

  walletId String

  amount Decimal @db.Decimal(18, 2)

  bankName String?

  accountNumber String?

  ifscCode String?

  upiId String?

  status WithdrawalStatus @default(PENDING)

  adminRemark String?

  processedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])

  @@index([status])
}

// ======================================================
// TASK
// ======================================================

model Task {
  id String @id @default(uuid())

  title String

  slug String @unique

  shortDescription String

  description String

  type TaskType

  rewardAmount Decimal @db.Decimal(18, 2)

  currency Currency @default(INR)

  status TaskStatus @default(DRAFT)

  totalSlots Int?

  completedSlots Int @default(0)

  startsAt DateTime?

  expiresAt DateTime?

  metadata Json?

  instructions Json?

  validationRules Json?

  isFeatured Boolean @default(false)

  createdBy String?

  updatedBy String?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  submissions TaskSubmission[]

  @@index([status])

  @@index([slug])
}

// ======================================================
// TASK SUBMISSION
// ======================================================

model TaskSubmission {
  id String @id @default(uuid())

  userId String

  taskId String

  status TaskSubmissionStatus @default(PENDING)

  submissionData Json

  adminRemark String?

  reviewedByAdminId String?

  reviewedBy String?

  reviewedAt DateTime?

  rewardTransactionId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  task Task @relation(fields: [taskId], references: [id])

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, taskId])

  @@index([status])

  @@index([taskId])
}

// ======================================================
// AD REWARD CAMPAIGN
// ======================================================

model AdRewardCampaign {
  id String @id @default(uuid())

  title String

  description String?

  rewardAmount Decimal @db.Decimal(18, 2)

  dailyLimit Int @default(10)

  totalLimit Int?

  adsProvider String

  placementId String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  claims AdRewardClaim[]

  @@index([isActive])
}

// ======================================================
// AD REWARD CLAIM
// ======================================================

model AdRewardClaim {
  id String @id @default(uuid())

  userId String

  campaignId String

  rewardAmount Decimal @db.Decimal(18, 2)

  status AdRewardStatus @default(SUCCESS)

  claimedAt DateTime @default(now())

  transactionId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  campaign AdRewardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@index([campaignId])

  @@index([claimedAt])
}

// ======================================================
// KYC
// ======================================================

model Kyc {
  id String @id @default(uuid())

  userId String @unique

  status KycStatus @default(PENDING)

  aadhaar String?

  pan String?

  passport String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@index([status])
}